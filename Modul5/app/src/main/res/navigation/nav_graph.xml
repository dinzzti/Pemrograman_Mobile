<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dramaListFragment">

    <fragment
        android:id="@+id/dramaListFragment"
        android:name="com.example.connectapi.presentation.ui.DramaListFragment"
        android:label="Series Lawas Populer"
        tools:layout="@layout/fragment_drama_list">
        <action
            android:id="@+id/action_dramaListFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>
    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.connectapi.presentation.ui.DetailFragment"
        android:label="Drama Detail"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="drama"
            app:argType="com.example.connectapi.domain.model.Drama" />
    </fragment>
</navigation>